<section class="py-24 relative z-10">
  <div class="max-w-5xl mx-auto px-6">
    <div class="bg-brand/5 border border-brand/20 rounded-3xl p-12 md:p-20 text-center relative overflow-hidden">
      
      <!-- Suave resplandor interior (sin cortes bruscos) -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full bg-gradient-to-b from-brand/10 to-transparent pointer-events-none"></div>
      
      <div class="relative z-10">
        <h2 class="text-4xl md:text-5xl font-display font-extrabold text-white mb-6">
          Empieza tu servidor hoy
        </h2>
        <p class="text-xl text-gray-400 mb-10 max-w-2xl mx-auto">
          Únete a otras comunidades que ya confían en ArkaniaHost. Despliegue instantáneo, soporte experto y todo el control que necesitas.
        </p>
        
        <a href="#planes" class="inline-flex items-center gap-3 bg-brand hover:bg-[#aa00d4] text-white px-10 py-4 rounded-md text-lg font-bold transition-all voxel-button shadow-[0_0_30px_rgba(204,0,255,0.4)] hover:shadow-[0_0_40px_rgba(204,0,255,0.6)]">
          Crear servidor <i class="fa-solid fa-rocket"></i>
        </a>
      </div>
    </div>
  </div>
</section>
