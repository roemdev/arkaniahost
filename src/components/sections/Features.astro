---
const features = [
  {
    title: "Instalación con un clic",
    description: "Despliega modpacks, plugins y versiones de servidor al instante.",
    icon: "fa-solid fa-wand-magic-sparkles"
  },
  {
    title: "Escalado flexible",
    description: "Aumenta la memoria RAM de tu servidor en cualquier momento.",
    icon: "fa-solid fa-arrow-up-right-dots"
  },
  {
    title: "Backups diarios",
    description: "Tus mundos y configuraciones a salvo con copias de seguridad automáticas.",
    icon: "fa-solid fa-clock-rotate-left"
  },
  {
    title: "Migración gratuita",
    description: "Trae tu servidor desde otro host sin costo adicional.",
    icon: "fa-solid fa-truck-fast"
  },
  {
    title: "Panel Pterodactyl completo",
    description: "La mejor interfaz de control de la industria, a tu disposición.",
    icon: "fa-solid fa-gears"
  },
  {
    title: "Java y Bedrock",
    description: "Juega en la edición que prefieras, o ambas al mismo tiempo.",
    icon: "fa-solid fa-gamepad"
  }
];
---

<section class="py-24 relative z-10">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map(feature => (
        <div class="flex gap-4 items-start">
          <div class="w-12 h-12 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center flex-shrink-0 text-brand">
            <i class={`${feature.icon} text-xl`}></i>
          </div>
          <div>
            <h3 class="text-lg font-bold text-white mb-2">{feature.title}</h3>
            <p class="text-sm text-gray-400 leading-relaxed">{feature.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
