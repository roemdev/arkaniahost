---
import { Image } from "astro:assets";
import logoMc from "../../assets/logo-mc-style.png";
---

<section class="pt-24 pb-12 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-12 items-center">
    <!-- Contenido Izquierdo -->
    <div class="space-y-5 relative z-10">
      <div
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand/10 border border-brand/20 text-brand text-xs font-medium tracking-wide backdrop-blur-sm"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand opacity-75"
          ></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-brand"
          ></span>
        </span>
        🎉 -20% por apertura | Código <strong
          class="font-bold text-white tracking-widest bg-brand/20 px-1.5 rounded"
          >ARKANIA20</strong
        >
      </div>

      <h1
        class="text-4xl md:text-5xl font-display font-black text-white leading-tight"
      >
        Hostea tu servidor de <span
          class="text-transparent bg-clip-text bg-gradient-to-r from-brand to-[#a300cc]"
          >Minecraft</span
        >
      </h1>

      <p class="text-base md:text-lg text-gray-400 font-light leading-relaxed max-w-lg">
        Rápido, simple y listo para jugar. Exclusivos de Latinoamérica. Empieza hoy mismo!
      </p>

      <!-- Botones y Precio -->
      <div class="flex flex-wrap items-center gap-6 pt-4">
        <a
          href="#planes"
          class="bg-brand hover:bg-[#aa00d4] text-white px-6 py-2.5 text-sm rounded-md font-semibold transition-all flex items-center gap-2 shadow-[0_0_20px_rgba(204,0,255,0.3)] hover:shadow-[0_0_30px_rgba(204,0,255,0.5)]"
        >
          <i class="fa-solid fa-play text-xs"></i> Crear servidor
        </a>
        <div class="flex flex-col">
          <span
            class="text-gray-400 text-xs uppercase tracking-wider font-semibold"
            >Planes desde</span
          >
          <div class="flex items-baseline gap-1">
            <span class="text-white text-2xl font-bold">$4.00</span>
            <span class="text-sm text-gray-500">/mes</span>
          </div>
        </div>
      </div>

      <!-- Etiquetas/Badges -->
      <div class="flex flex-wrap gap-4 pt-6">
        <div class="flex items-center gap-2 text-sm text-gray-400">
          <i class="fa-solid fa-check text-green-500"></i> Java y Bedrock
        </div>
        <div class="flex items-center gap-2 text-sm text-gray-400">
          <i class="fa-solid fa-check text-green-500"></i> Backups diarios
        </div>
        <div class="flex items-center gap-2 text-sm text-gray-400">
          <i class="fa-solid fa-check text-green-500"></i> Respuesta &lt;15 min
        </div>
        <div class="flex items-center gap-2 text-sm text-gray-400">
          <i class="fa-solid fa-check text-green-500"></i> 99%+ uptime
        </div>
      </div>
    </div>

    <!-- Visual Derecho: Logo 3D Flotante -->
    <div
      class="relative z-10 w-full max-w-lg mx-auto lg:max-w-none flex justify-center items-center"
    >
      <!-- Resplandor trasero -->
      <div
        class="absolute inset-0 bg-brand/30 blur-[120px] rounded-full pointer-events-none w-3/4 h-3/4 m-auto"
      >
      </div>

      <!-- Contenedor del logo con animación de flotación en loop -->
      <div class="relative w-[95%] mx-auto">
        <!-- Se añade un drop-shadow oscuro y ajustado a los bordes para suavizar el corte, más la sombra volumétrica -->
        <Image
          src={logoMc}
          alt="ArkaniaHost Logo"
          class="w-full h-auto drop-shadow-[0_20px_50px_rgba(204,0,255,0.5)] animate-float"
          style="filter: drop-shadow(0 0 8px rgba(0,0,0,0.8)) drop-shadow(0 25px 25px rgba(0,0,0,0.6));"
        />

        <!-- Reflejo o base inferior que se achica cuando el logo sube -->
        <div
          class="absolute -bottom-10 left-1/2 -translate-x-1/2 w-2/3 h-4 bg-black blur-xl rounded-[100%] animate-shadow"
        >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes float {
    0% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-20px);
    }
    100% {
      transform: translateY(0px);
    }
  }
  @keyframes shadowPulse {
    0% {
      transform: translateX(-50%) scale(1);
      opacity: 0.4;
    }
    50% {
      transform: translateX(-50%) scale(0.8);
      opacity: 0.15;
    }
    100% {
      transform: translateX(-50%) scale(1);
      opacity: 0.4;
    }
  }
  .animate-float {
    animation: float 6s ease-in-out infinite;
  }
  .animate-shadow {
    animation: shadowPulse 6s ease-in-out infinite;
  }
</style>
