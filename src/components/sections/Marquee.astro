---
import { MARQUEE_FEATURES } from "../../data/navigation";
---

<section class="py-12 relative z-10 border-y border-white/5 bg-[#050505]">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center md:divide-x divide-white/5">
      {MARQUEE_FEATURES.map((feature, i) => (
        <div class="px-4 reveal" style={`transition-delay: ${i * 100}ms;`}>
          <div class="text-white mb-3"><i class={`${feature.icon} text-xl`}></i></div>
          <p class="text-gray-300 text-sm font-bold">{feature.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>