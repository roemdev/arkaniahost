---
import { Image } from "astro:assets";
import panelImg from "../../assets/panel.png";

// Se combinan los mejores beneficios de la imagen 1 y de la imagen 2 con iconos coloreados individualmente
const panelFeatures = [
  { label: "Gestor de archivos", icon: "fa-solid fa-folder-open", iconClass: "text-amber-400", bgClass: "bg-amber-500/10 border border-amber-500/20" },
  { label: "Consola en vivo", icon: "fa-solid fa-terminal", iconClass: "text-emerald-400", bgClass: "bg-emerald-500/10 border border-emerald-500/20" },
  { label: "Instalación en 1 clic", icon: "fa-solid fa-wand-magic-sparkles", iconClass: "text-blue-400", bgClass: "bg-blue-500/10 border border-blue-500/20" },
  { label: "Backups diarios", icon: "fa-solid fa-box-archive", iconClass: "text-orange-400", bgClass: "bg-orange-500/10 border border-orange-500/20" },
  { label: "Java y Bedrock", icon: "fa-solid fa-gamepad", iconClass: "text-violet-400", bgClass: "bg-violet-500/10 border border-violet-500/20" },
  { label: "Migración gratuita", icon: "fa-solid fa-truck-fast", iconClass: "text-pink-400", bgClass: "bg-pink-500/10 border border-pink-500/20" }
];
---

<section class="py-24 relative z-10 bg-[#060606] overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-2 gap-16 items-center">
    
    <!-- Texto -->
    <div class="space-y-6">
      <h2 class="text-3xl md:text-5xl font-display font-bold text-white leading-tight">
        Administra todo tu servidor desde <span class="text-brand">un solo lugar</span>.
      </h2>
      <p class="text-lg text-gray-400 font-light max-w-lg">
        Nuestro panel Pterodactyl personalizado te da control absoluto sobre tu servidor. Sin complicaciones, sin consolas confusas. Todo a un clic de distancia.
      </p>

      <div class="grid grid-cols-2 gap-4 pt-4">
        {panelFeatures.map(f => (
          <div class="flex items-center gap-3 text-white">
            <div class={`w-8 h-8 rounded-md flex items-center justify-center flex-shrink-0 ${f.bgClass} ${f.iconClass}`}>
              <i class={`${f.icon} text-sm`}></i>
            </div>
            <span class="text-sm font-medium">{f.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Visual (Imagen Panel) -->
    <div class="relative">
      <div class="absolute inset-0 bg-brand/20 blur-[100px] rounded-full"></div>
      <div class="relative rounded-xl overflow-hidden shadow-2xl border border-white/10 group z-10">
        <div class="absolute inset-0 bg-brand/20 opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
        <Image src={panelImg} alt="Panel Pterodactyl" class="w-full h-auto object-cover transform hover:scale-105 transition-transform duration-700" />
      </div>
    </div>

  </div>
</section>
