---
// Se definen los planes y las URLs de checkout/ticket correspondientes
const plans = [
  {
    id: "3",
    name: "Starter",
    ram: "3GB",
    price: "$4",
    desc: "Ideal para jugar con hasta 5 amigos en mundos Vanilla tradicionales sin mods. La opción perfecta para entrar, construir y explorar juntos de forma fluida y sin complicaciones.",
    link: "https://billing.arkaniahost.xyz/products/servidores-de-minecraft/starter/checkout",
    popular: false,
  },
  {
    id: "6",
    name: "Plus",
    ram: "6GB",
    price: "$7",
    desc: "Nuestro plan recomendado. Soporta con total soltura casi cualquier modpack de la actualidad y servidores survival con plugins avanzados y un grupo de 10 a 15 jugadores activos.",
    link: "https://billing.arkaniahost.xyz/products/servidores-de-minecraft/plus/checkout",
    popular: true,
  },
  {
    id: "9",
    name: "Pro",
    ram: "9GB",
    price: "$10",
    desc: "Diseñado para comunidades en crecimiento y servidores con mods pesados. Soporta dinámicas complejas, mapas personalizados y modpacks exigentes con gran fluidez y rendimiento estable.",
    link: "https://billing.arkaniahost.xyz/products/servidores-de-minecraft/pro/checkout",
    popular: false,
  },
  {
    id: "12",
    name: "Elite",
    ram: "12GB",
    price: "$13",
    desc: "La opción definitiva para proyectos públicos y creadores exigentes. Soporta absolutamente cualquier modpack del mercado, una gran cantidad de plugins y decenas de jugadores simultáneos.",
    link: "https://billing.arkaniahost.xyz/products/servidores-de-minecraft/elite/checkout",
    popular: false,
  },
  {
    id: "custom",
    name: "Personalizado",
    ram: "Personalizado",
    price: "Consultar",
    desc: "Para grandes comunidades, redes interconectadas de servidores o proyectos masivos. Cuéntanos tu idea en un ticket de soporte y configuramos a medida toda la potencia que necesitas.",
    link: "https://billing.arkaniahost.xyz/admin/tickets/create",
    popular: false,
  },
];
---

<section id="planes" class="py-24 relative z-10">
  <!-- Resplandor de fondo sutil -->
  <div
    class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[700px] h-[300px] bg-brand/5 blur-[120px] rounded-full pointer-events-none z-[-1]"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6">
    <!-- TÍTULO Y DESCRIPCIÓN DE LA SECCIÓN (Homólogo con las demás secciones) -->
    <div class="text-center mb-16 animate-fade-in-up">
      <h2 class="text-3xl md:text-5xl font-display font-bold text-white mb-4">
        Planes simples, sin sorpresas
      </h2>
      <p
        class="text-base md:text-lg text-gray-400 font-light max-w-2xl mx-auto"
      >
        Todos nuestros planes incluyen la misma infraestructura premium.
        Selecciona la memoria RAM ideal para tu comunidad.
      </p>
    </div>

    <!-- CONFIGURADOR EN DOS TARJETAS IGUALES -->
    <div class="grid lg:grid-cols-2 gap-8 items-stretch max-w-7xl mx-auto">
      <!-- TARJETA IZQUIERDA: Especificaciones técnicas (1 Columna) -->
      <div
        class="bg-white/[0.02] backdrop-blur-[16px] border border-white/5 p-6 md:p-8 rounded-2xl flex flex-col gap-6 shadow-xl w-full"
      >
        <div>
          <h3
            class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-6 flex items-center gap-2"
          >
            <i class="fa-solid fa-microchip text-brand text-xs"></i> Datos Técnicos
          </h3>

          <ul class="flex flex-col gap-y-5">
            <li class="flex items-center gap-5 text-gray-300">
              <div
                class="w-12 h-12 rounded-xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400 flex-shrink-0"
              >
                <i class="fa-solid fa-microchip text-xl"></i>
              </div>
              <div class="min-w-0">
                <span
                  class="text-xs text-gray-400 uppercase font-bold tracking-wider block mb-1"
                  >Procesador</span
                >
                <span class="text-white font-medium text-base block"
                  >Intel i5-4770S (3.50 GHz)</span
                >
              </div>
            </li>

            <li class="flex items-center gap-5 text-gray-300">
              <div
                class="w-12 h-12 rounded-xl bg-violet-500/10 border border-violet-500/20 flex items-center justify-center text-violet-400 flex-shrink-0"
              >
                <i class="fa-solid fa-memory text-xl"></i>
              </div>
              <div class="min-w-0">
                <span
                  class="text-xs text-gray-400 uppercase font-bold tracking-wider block mb-1"
                  >Memoria RAM</span
                >
                <span class="text-white font-medium text-base block"
                  >DDR3 2400MHz</span
                >
              </div>
            </li>

            <li class="flex items-center gap-5 text-gray-300">
              <div
                class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 flex-shrink-0"
              >
                <i class="fa-solid fa-database text-xl"></i>
              </div>
              <div class="min-w-0">
                <span
                  class="text-xs text-gray-400 uppercase font-bold tracking-wider block mb-1"
                  >Disco</span
                >
                <span class="text-white font-medium text-base block"
                  >SSD Ilimitado</span
                >
              </div>
            </li>

            <li class="flex items-center gap-5 text-gray-300">
              <div
                class="w-12 h-12 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-400 flex-shrink-0"
              >
                <i class="fa-solid fa-map-marker-alt text-xl"></i>
              </div>
              <div class="min-w-0">
                <span
                  class="text-xs text-gray-400 uppercase font-bold tracking-wider block mb-1"
                  >Ubicación</span
                >
                <span class="text-white font-medium text-base block"
                  >Pennsylvania, USA</span
                >
              </div>
            </li>

            <li class="flex items-center gap-5 text-gray-300">
              <div
                class="w-12 h-12 rounded-xl bg-yellow-500/10 border border-yellow-500/20 flex items-center justify-center text-yellow-400 flex-shrink-0"
              >
                <i class="fa-solid fa-layer-group text-xl"></i>
              </div>
              <div class="min-w-0">
                <span
                  class="text-xs text-gray-400 uppercase font-bold tracking-wider block mb-1"
                  >Versiones</span
                >
                <span class="text-white font-medium text-base block"
                  >Instala casi cualquier versión de Minecraft</span
                >
              </div>
            </li>
          </ul>
        </div>

        <!-- Ficha de descripción dinámica (Ubicada debajo de Datos Técnicos) -->
        <div
          class="bg-white/[0.01] border border-white/5 p-5 md:p-6 rounded-xl space-y-3 mt-auto"
        >
          <div class="text-sm font-semibold text-white flex items-center gap-2">
            <i class="fa-solid fa-circle-info text-brand text-sm"></i>
            <span>Servidor <span id="dynamic-ram-name-label">Plus</span></span>
          </div>
          <p
            id="dynamic-desc-label"
            class="text-xs md:text-sm text-gray-300 font-light leading-relaxed"
          >
            Nuestro plan recomendado. Soporta con total soltura casi cualquier
            modpack de la actualidad y servidores survival con plugins avanzados
            y un grupo de 10 a 15 jugadores activos.
          </p>
        </div>
      </div>

      <!-- TARJETA DERECHA: Selector interactivo de RAM (1 Columna) -->
      <div
        class="bg-white/[0.02] backdrop-blur-[16px] border border-white/5 p-6 md:p-8 rounded-2xl flex flex-col justify-between gap-6 shadow-xl w-full"
      >
        <div>
          <h3
            class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-6 flex items-center gap-2"
          >
            <i class="fa-solid fa-sliders text-brand text-xs"></i> Configura tu RAM
          </h3>

          <!-- Botones del Selector de RAM (En 1 sola columna vertical) -->
          <div class="flex flex-col gap-3" id="ram-selector-container">
            {
              plans.map((p) => {
                const isCustom = p.id === "custom";
                if (isCustom) return null;
                return (
                  <button
                    type="button"
                    data-ram-id={p.id}
                    data-ram-price={p.price}
                    data-ram-desc={p.desc}
                    data-ram-link={p.link}
                    data-ram-name={p.name}
                    class={`w-full text-left py-3 px-4 md:px-5 rounded-xl border flex items-center justify-between cursor-pointer transition-all duration-300 outline-none focus:outline-none ${
                      p.popular
                        ? "border-brand bg-brand/5 shadow-[0_0_15px_rgba(163,0,204,0.15)]"
                        : "border-white/10 bg-transparent hover:border-white/20"
                    }`}
                  >
                    <div class="flex flex-col">
                      <div class="flex items-center gap-2">
                        <span class="font-bold text-white text-base">
                          {isCustom ? p.ram : `${p.ram} RAM`}
                        </span>
                        {p.popular && (
                          <span class="bg-brand text-white text-[7px] font-bold uppercase tracking-wider py-0.5 px-2 rounded">
                            Recomendado
                          </span>
                        )}
                      </div>
                      <div class="text-[10px] text-gray-500 mt-0.5 uppercase tracking-wider">
                        Plan {p.name}
                      </div>
                    </div>
                    {!isCustom && (
                      <div class="text-white font-bold">
                        {p.price}
                        <span class="text-xs text-gray-500 font-normal ml-0.5">
                          /mes
                        </span>
                      </div>
                    )}
                  </button>
                );
              })
            }
          </div>
        </div>

        <!-- Compra (Derecha) -->
        <div class="space-y-4 border-t border-white/[0.05] pt-6 mt-4">
          <!-- Botón Dinámico de Acción -->
          <div class="flex flex-col">
            <a
              id="dynamic-cta-button"
              href="https://billing.arkaniahost.xyz/products/servidores-de-minecraft/plus/checkout"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-4 rounded-xl font-bold bg-brand hover:bg-[#aa00d4] text-white text-base text-center flex items-center justify-center gap-2 voxel-button shadow-lg shadow-brand/10 transition-all duration-300 active:scale-95"
            >
              <span id="dynamic-btn-text">Contratar 6GB RAM</span>
              <i class="fa-solid fa-cart-shopping text-xs" id="dynamic-btn-icon"
              ></i>
            </a>

            <span
              class="text-[10px] md:text-xs text-center text-gray-500 block mt-3 font-light"
            >
              Activación inmediata • Cancela en cualquier momento
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Script de interactividad del selector de RAM -->
<script>
  function setupRamSelector() {
    const container = document.getElementById("ram-selector-container");
    if (!container) return;

    const buttons = container.querySelectorAll("button[data-ram-id]");
    const priceLabel = document.getElementById("dynamic-price-label");
    const periodLabel = document.getElementById("dynamic-period-label");
    const ramNameLabel = document.getElementById("dynamic-ram-name-label");
    const descLabel = document.getElementById("dynamic-desc-label");
    const ctaBtn = document.getElementById("dynamic-cta-button");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        // Remover clases activas de todos
        buttons.forEach((b) => {
          b.classList.remove(
            "border-brand",
            "bg-brand/5",
            "shadow-[0_0_15px_rgba(163,0,204,0.15)]",
          );
          b.classList.add(
            "border-white/10",
            "bg-transparent",
            "hover:border-white/20",
          );
        });

        // Añadir clases activas al seleccionado
        btn.classList.remove(
          "border-white/10",
          "bg-transparent",
          "hover:border-white/20",
        );
        btn.classList.add(
          "border-brand",
          "bg-brand/5",
          "shadow-[0_0_15px_rgba(163,0,204,0.15)]",
        );

        // Leer atributos de datos
        const ramId = btn.getAttribute("data-ram-id") || "";
        const price = btn.getAttribute("data-ram-price") || "";
        const desc = btn.getAttribute("data-ram-desc") || "";
        const link = btn.getAttribute("data-ram-link") || "";
        const name = btn.getAttribute("data-ram-name") || "";

        // Actualizar interfaz
        if (priceLabel) priceLabel.textContent = price;

        if (periodLabel) {
          if (price === "Consultar") {
            periodLabel.textContent = "";
          } else {
            periodLabel.textContent = " /mes";
          }
        }

        if (ramNameLabel) ramNameLabel.textContent = name;
        if (descLabel) descLabel.textContent = desc;

        // Actualizar botón dinámico (invento)
        if (ctaBtn) {
          ctaBtn.setAttribute("href", link);

          if (ramId === "custom") {
            ctaBtn.innerHTML = `
              <span>Crear Ticket de Soporte</span>
              <i class="fa-solid fa-headset text-xs"></i>
            `;
            // Cambiar a color más personalizado
            ctaBtn.classList.remove(
              "bg-brand",
              "hover:bg-[#aa00d4]",
              "shadow-brand/10",
            );
            ctaBtn.classList.add(
              "bg-violet-700",
              "hover:bg-violet-800",
              "shadow-violet-700/10",
            );
          } else {
            ctaBtn.innerHTML = `
              <span>Contratar ${ramId}GB RAM</span>
              <i class="fa-solid fa-cart-shopping text-xs"></i>
            `;
            ctaBtn.classList.remove(
              "bg-violet-700",
              "hover:bg-violet-800",
              "shadow-violet-700/10",
            );
            ctaBtn.classList.add(
              "bg-brand",
              "hover:bg-[#aa00d4]",
              "shadow-brand/10",
            );
          }
        }
      });
    });
  }

  // Inicializar al cargar y ante cambios de página (para transiciones suaves en Astro)
  setupRamSelector();
  document.addEventListener("astro:after-swap", setupRamSelector);
</script>
