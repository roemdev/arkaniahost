---
const plans = [
  {
    name: "Starter",
    ram: "3GB",
    price: "$4",
    features: ["Panel Pterodactyl", "Backups diarios", "Soporte Java & Bedrock", "Subdominio gratis"],
    popular: false
  },
  {
    name: "Plus",
    ram: "6GB",
    price: "$7",
    features: ["Panel Pterodactyl", "Backups diarios", "Soporte Java & Bedrock", "Subdominio gratis"],
    popular: true
  },
  {
    name: "Pro",
    ram: "9GB",
    price: "$10",
    features: ["Panel Pterodactyl", "Backups diarios", "Soporte Java & Bedrock", "Subdominio gratis"],
    popular: false
  },
  {
    name: "Elite",
    ram: "12GB",
    price: "$13",
    features: ["Panel Pterodactyl", "Backups diarios", "Soporte Java & Bedrock", "Subdominio gratis"],
    popular: false
  }
];
---

<section id="planes" class="py-24 relative z-10">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-display font-bold text-white mb-4">Planes simples, sin sorpresas</h2>
      <p class="text-gray-400 max-w-xl mx-auto">Elige el plan ideal para tu servidor y escálalo cuando tu comunidad crezca.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {plans.map((plan) => (
        <div class={`glass-card p-6 rounded-xl flex flex-col ${plan.popular ? 'border-brand/50 bg-brand/5 scale-105' : 'border-white/10'}`}>
          {plan.popular && (
            <div class="bg-brand text-white text-xs font-bold uppercase tracking-wider py-1 px-3 rounded-full self-start mb-4">
              Más popular
            </div>
          )}
          <h3 class="text-xl font-bold text-white mb-2">{plan.name}</h3>
          <div class="mb-6">
            <span class="text-4xl font-extrabold text-white">{plan.price}</span>
            <span class="text-gray-400 text-sm">/mes</span>
          </div>
          <div class="text-2xl font-bold text-brand mb-6">{plan.ram} <span class="text-sm font-medium text-gray-400">RAM</span></div>
          
          <ul class="space-y-3 mb-8 flex-grow">
            {plan.features.map(f => (
              <li class="flex items-center gap-3 text-sm text-gray-300">
                <i class="fa-solid fa-check text-green-500"></i> {f}
              </li>
            ))}
          </ul>
          
          <a href="#" class={`w-full text-center py-3 rounded-md font-semibold transition-colors voxel-button ${plan.popular ? 'bg-brand hover:bg-[#aa00d4] text-white' : 'bg-white/10 hover:bg-white/20 text-white'}`}>
            Seleccionar Plan
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
