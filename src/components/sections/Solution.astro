---
import { SOLUTION_CARDS } from "../../data/navigation";
---

<section id="solucion" class="py-24 relative z-10">
  <div class="max-w-7xl mx-auto px-6">

    <div class="text-center mb-16 max-w-2xl mx-auto">
      <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight mb-4 text-white">
        Ingeniería <span class="text-brand">invisible.</span>
      </h2>
      <p class="text-gray-400 text-lg font-light leading-relaxed">
        Ocultamos la complejidad técnica, dejándote con el control absoluto de tu servidor.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {SOLUTION_CARDS.map((card, i) => (
        <div class="glass-card p-8 flex flex-col js-reveal text-center md:text-left" style={`transition-delay: ${i * 100}ms`}>
          <div class="w-12 h-12 mx-auto md:mx-0 rounded bg-white/[0.03] border border-white/10 flex items-center justify-center mb-6 text-white group-hover:text-brand">
            <i class={`${card.icon} text-lg`}></i>
          </div>
          <h3 class="font-display text-xl font-bold mb-3 text-white">{card.title}</h3>
          <p class="text-gray-400 text-sm leading-relaxed font-light">{card.description}</p>
        </div>
      ))}
    </div>

  </div>
</section>
