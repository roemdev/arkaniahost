<section class="py-12 relative z-10 border-y border-white/5 bg-[#050505]">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center md:divide-x divide-white/5">
      
      <div class="px-4 reveal">
        <h3 class="font-display text-2xl md:text-3xl font-bold text-white mb-1">+3</h3>
        <p class="text-brand text-[10px] md:text-xs tracking-widest uppercase font-bold">Servidores Activos</p>
      </div>
      
      <div class="px-4 reveal" style="transition-delay: 100ms;">
        <h3 class="font-display text-2xl md:text-3xl font-bold text-white mb-1">99%</h3>
        <p class="text-brand text-[10px] md:text-xs tracking-widest uppercase font-bold">SLA Garantizado</p>
      </div>
      
      <div class="px-4 reveal" style="transition-delay: 200ms;">
        <h3 class="font-display text-2xl md:text-3xl font-bold text-white mb-1">&lt;15m</h3>
        <p class="text-brand text-[10px] md:text-xs tracking-widest uppercase font-bold">Respuesta Soporte</p>
      </div>
      
      <div class="px-4 reveal" style="transition-delay: 300ms;">
        <h3 class="font-display text-2xl md:text-3xl font-bold text-white mb-1">NVMe</h3>
        <p class="text-brand text-[10px] md:text-xs tracking-widest uppercase font-bold">Almacenamiento</p>
      </div>

    </div>
  </div>
</section>
