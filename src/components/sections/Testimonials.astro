---
const testimonials = [
  {
    name: "Alex M.",
    role: "Administrador de Servidor",
    text: "Migrar nuestro SMP a ArkaniaHost fue la mejor decisión. El panel es súper intuitivo y no hemos tenido caídas en los últimos meses. Recomendado 100%.",
    avatar: "https://api.dicebear.com/7.x/avataaars/svg?seed=Alex&backgroundColor=b6e3f4"
  },
  {
    name: "Sofía R.",
    role: "Creadora de Contenido",
    text: "El soporte me ayudó a configurar mi modpack en menos de 15 minutos. El servidor va súper fluido incluso con más de 100 mods cargados.",
    avatar: "https://api.dicebear.com/7.x/avataaars/svg?seed=Sofia&backgroundColor=c0aede"
  },
  {
    name: "Carlos T.",
    role: "Owner de Network",
    text: "Tenemos nuestro lobby en Bedrock y Java conectando sin problemas. El rendimiento del Xeon se nota mucho comparado con otros hosts genéricos.",
    avatar: "https://api.dicebear.com/7.x/avataaars/svg?seed=Carlos&backgroundColor=ffdfbf"
  }
];
---

<section class="py-24 relative z-10">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-display font-bold text-white mb-4">Lo que dicen nuestros clientes</h2>
      <p class="text-gray-400">Comunidades que ya confían en nuestra infraestructura.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {testimonials.map(t => (
        <div class="glass-card p-6 border border-white/5 rounded-xl flex flex-col">
          <div class="flex items-center gap-1 text-brand mb-4">
            <i class="fa-solid fa-star text-sm"></i>
            <i class="fa-solid fa-star text-sm"></i>
            <i class="fa-solid fa-star text-sm"></i>
            <i class="fa-solid fa-star text-sm"></i>
            <i class="fa-solid fa-star text-sm"></i>
          </div>
          <p class="text-gray-300 text-sm leading-relaxed mb-6 flex-grow">"{t.text}"</p>
          <div class="flex items-center gap-3 mt-auto">
            <img src={t.avatar} alt={t.name} class="w-10 h-10 rounded-full bg-white/10" />
            <div>
              <div class="text-white font-medium text-sm">{t.name}</div>
              <div class="text-gray-500 text-xs">{t.role}</div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
