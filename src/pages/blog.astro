---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
---

<BaseLayout title="Blog | ArkaniaHost">
  <div class="absolute w-full z-50 top-0 flex flex-col">
    <Navbar />
  </div>

  <main class="py-24 md:py-32 max-w-4xl mx-auto px-6 relative z-10 min-h-[70vh] flex flex-col justify-center">
    <div class="text-center mb-12 animate-fade-in-up">
      <h1 class="font-display text-4xl md:text-5xl font-bold tracking-tight text-white mb-4">
        Nuestro <span class="text-brand">Blog</span>
      </h1>
      <p class="text-gray-400 text-lg font-light leading-relaxed max-w-2xl mx-auto">
        Guías, anuncios y recursos técnicos para sacarle el máximo partido a tu servidor.
      </p>
    </div>

    <div class="glass-card p-12 md:p-20 text-center animate-fade-in-up" style="animation-delay: 0.1s;">
      <div class="w-16 h-16 rounded bg-white/[0.05] border border-white/10 flex items-center justify-center mx-auto mb-6 text-gray-500">
        <i class="fa-solid fa-pen-nib text-2xl"></i>
      </div>
      <h3 class="font-display text-2xl font-bold mb-4 text-white">Preparando el primer artículo</h3>
      <p class="text-gray-400 text-sm leading-relaxed font-light max-w-md mx-auto mb-8">
        Nuestros ingenieros y redactores están trabajando en contenido técnico detallado. Pronto publicaremos nuestras primeras guías de optimización.
      </p>
      <a href="https:
        Síguenos en Discord <i class="fa-solid fa-arrow-right text-[10px]"></i>
      </a>
    </div>
  </main>

  <Footer />
</BaseLayout>
