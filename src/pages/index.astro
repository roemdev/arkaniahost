---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/layout/Navbar.astro";
import Footer from "../components/layout/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import Pricing from "../components/sections/Pricing.astro";
import Experiences from "../components/sections/Experiences.astro";
import Features from "../components/sections/Features.astro";
import PanelPreview from "../components/sections/PanelPreview.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import FAQ from "../components/sections/FAQ.astro";
import BottomCTA from "../components/sections/BottomCTA.astro";

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://arkaniahost.xyz/#organization",
      name: "ArkaniaHost",
      url: "https://arkaniahost.xyz",
      logo: {
        "@type": "ImageObject",
        url: "https://arkaniahost.xyz/favicon.ico",
      },
      sameAs: ["https://discord.arkaniahost.xyz"],
    },
    {
      "@type": "WebSite",
      "@id": "https://arkaniahost.xyz/#website",
      url: "https://arkaniahost.xyz",
      name: "ArkaniaHost",
      description:
        "Hosting de servidores de Minecraft en Pennsylvania, USA con almacenamiento SSD y panel Pterodactyl. Java y Bedrock, instalación en un clic.",
      publisher: {
        "@id": "https://arkaniahost.xyz/#organization",
      },
    },
    {
      "@type": "Product",
      "@id": "https://arkaniahost.xyz/#product",
      name: "Hosting Minecraft Premium",
      description:
        "Servidores de Minecraft con procesadores Xeon, almacenamiento SSD, panel Pterodactyl y 99%+ de uptime.",
      brand: {
        "@type": "Brand",
        name: "ArkaniaHost",
      },
      offers: {
        "@type": "Offer",
        url: "https://arkaniahost.xyz/#planes",
        priceCurrency: "USD",
        price: "4.00",
        availability: "https://schema.org/InStock",
      },
    },
  ],
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <Navbar />

  <main>
    <Hero />
    <Pricing />
    <Experiences />
    <Features />
    <PanelPreview />
    <Testimonials />
    <FAQ />
    <BottomCTA />
  </main>

  <Footer />
</BaseLayout>

<script>
  // Simple reveal if needed, o quitar
  // import "../scripts/reveal.ts";
</script>
